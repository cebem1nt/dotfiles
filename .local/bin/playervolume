#!/bin/bash

ARG=$1

if [[ $ARG =~ ^([0-9]+)([+-])$ ]]; then
    ARG=$(awk -v n="${BASH_REMATCH[1]}" -v s="${BASH_REMATCH[2]}" 'BEGIN { printf "%g%s", n/100, s }')
fi

if playerctl volume "$ARG"; then
    ICON=$(playerctl -l | head -n 1 | cut -d '.' -f 1)
    VOLUME=$(playerctl volume)
    VOLUME_INT=$(awk -v v="$VOLUME" 'BEGIN { printf "%.0f", v*100 }')
    
    notify-send --app-name="$0" --icon="$ICON" \
        "Current volume is: $VOLUME_INT%" \
        -h "string:x-canonical-private-synchronous:$0"
fi

