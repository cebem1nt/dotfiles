{
    "interval": 30, 
    "wallpapers_dir": "$XDG_PICTURES_DIR/wallpapers", 
    "wallpapers_cli": "awww img <picture>", 
    "keyboard_cli": "asusctl aura effect static -c <color>", 
    "keyboard_transition_cli": "asusctl aura effect breathe --colour <prev> --colour2 <color> --speed high", 
    "change_backlight": false, 
    "notify": true, 
    "transition_duration": 1,
    "backlight_transition": true, 
    "rofi_theme": "~/.config/rofi/themes/wallpapers.rasi"
}
