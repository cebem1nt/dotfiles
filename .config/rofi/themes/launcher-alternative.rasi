@import "colors/colors.rasi"

* {
    font:                        "CaskaydiaCove Nerd Font, bold 12";
}

configuration {
    show-icons:                  true;
	drun-display-format:         "{name} \n<span size='x-small' color='grey'><i>{exec}</i></span>";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               15px;
    cursor:                      "default";
    background-color:            @background;
}

mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

inputbar {
    margin:                      0px;
    spacing:                     10px;
    padding:                     5px 15px;
    border-radius:               16px;
    background-color:            @background-alt;
    color:                       @foreground;
    children:                    [ "entry", "mode-switcher" ];
}

entry {
    enabled:                     true;
    background-color:            inherit;
    color:                       inherit;
    placeholder-color:           inherit;
    placeholder:                 "Search...";
    vertical-align:              0.5;   
}

mode-switcher {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0;
    padding:                     0;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    color:                       @foreground;
}

button {
    font:                        "CaskaydiaCove Nerd Font Propo, bold 12";
    padding:                     10px 15px;
    margin:                      0px;
    border:                      0px;
    border-radius:               16px;
    background-color:            @highlight;
    color:                       inherit;
    cursor:                      pointer;
    horizontal-align:            0.5;
    width:                       45px;
    height:                      45px;
    vertical-align:              0.5;
}

button selected {
    background-color:            @foreground;
    color:                       @background;
}

listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    margin:                      0px;
    border:                      0px solid;
    padding:                     10px 8px;
    border-radius:               16px;
    background-color:            @background-alt;
    color:                       @foreground;
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     3px 10px;
    border:                      0px;
    border-radius:               10px;
    background-color:            transparent;
    color:                       @foreground;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @highlight;
}

element-icon {
    background-color:            transparent;
    color:                       inherit;
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    color:                       inherit;
    cursor:                      inherit;
    padding:                     10px 0;
    vertical-align:              0.5;
}

message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    background-color:            transparent;
    color:                       @foreground;
}

textbox {
    padding:                     8px 10px;
    border:                      0px solid;
    border-radius:               10px;
    background-color:            @background-alt;
    color:                       @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}

error-message {
    padding:                     10px;
    border-radius:               0px;
    background-color:            @background;
    color:                       @foreground;
}
